<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Cloud.UI.Views.CrashDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Cloud.Crash.ViewModels">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Padding="24" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Content="Back" Click="Back_Click" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.TopFrame, Mode=OneWay}" Opacity="0.7" />
                </StackPanel>
                <Button Grid.Column="2" Content="Refresh" Command="{x:Bind ViewModel.RefreshCommand}" />
            </Grid>

            <InfoBar Grid.Row="1" Severity="Error" Title="Error" IsClosable="False"
                 IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                 Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />

            <Border Grid.Row="2" Padding="16" CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="4">
                    <TextBlock Text="{x:Bind ViewModel.SampleMessage, Mode=OneWay}" TextWrapping="Wrap" />
                    <TextBlock>
                    <Run Text="Category: " /><Run Text="{x:Bind ViewModel.CategoryText, Mode=OneWay}" />
                    <Run Text="   Module: " /><Run Text="{x:Bind ViewModel.Module, Mode=OneWay}" />
                    <Run Text="   Count: " /><Run Text="{x:Bind ViewModel.CountText, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock>
                    <Run Text="First seen: " /><Run Text="{x:Bind ViewModel.FirstSeenText, Mode=OneWay}" />
                    <Run Text="   Last seen: " /><Run Text="{x:Bind ViewModel.LastSeenText, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock>
                    <Run Text="Fingerprint: " /><Run Text="{x:Bind ViewModel.Fingerprint, Mode=OneWay}" FontFamily="Consolas" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <Grid Grid.Row="3" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <ListView MaxHeight="420" ItemsSource="{x:Bind ViewModel.Reports, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedReport, Mode=TwoWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:CrashReportItem">
                            <StackPanel Padding="0,6">
                                <TextBlock Text="{x:Bind Summary}" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind SourceText}" Opacity="0.7" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Grid Grid.Column="1" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="2*" />
                    </Grid.RowDefinitions>
                    <TextBox Header="Frames (root cause)" MinHeight="120" MaxHeight="220" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         Text="{x:Bind ViewModel.SelectedFramesText, Mode=OneWay}" />
                    <TextBox Grid.Row="1" Header="Full exception text" MinHeight="200" MaxHeight="420" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         Text="{x:Bind ViewModel.SelectedReportText, Mode=OneWay}" />
                </Grid>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
