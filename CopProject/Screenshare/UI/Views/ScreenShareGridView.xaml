<UserControl
    x:Class="ScreenShare.Views.ScreenShareGridView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:ScreenShare.Models">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- GRID MODE (scrollable) -->
        <Grid Grid.Row="0" Visibility="{x:Bind ViewModel.IsGridMode, Mode=OneWay}">
            <GridView x:Name="TileGrid"
                      ItemsSource="{x:Bind ViewModel.Tiles}"
                      SelectionMode="None"
                      IsItemClickEnabled="True"
                      ItemClick="Tile_Click"
                      ContainerContentChanging="TileGrid_ContainerContentChanging"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">


                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" CacheLength="2"/>
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>


                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:ParticipantTile">
                        <Grid Margin="4" CornerRadius="8" Background="Black" Width="320" Height="180">
                            <Image Source="{x:Bind Frame, Mode=OneWay}" Stretch="Uniform"/>
                            <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="8"
                                    Padding="8,4" CornerRadius="4" Background="#99000000">
                                <TextBlock Text="{x:Bind Name}" Foreground="White"/>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </Grid>

        <!-- ZOOMED MODE -->
        <Grid Grid.Row="0" Visibility="{x:Bind ViewModel.IsZoomedMode, Mode=OneWay}" Background="Black">
            <Image Source="{x:Bind ViewModel.ZoomedTile.Frame, Mode=OneWay}" Stretch="Uniform"/>
            <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="12"
                    Padding="8,4" CornerRadius="4" Background="#99000000">
                <TextBlock Text="{x:Bind ViewModel.ZoomedTile.Name, Mode=OneWay}" Foreground="White"/>
            </Border>
            <!-- pictures drawn per second for the zoomed stream, updated once a second -->
            <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="12"
                    Padding="8,4" CornerRadius="4" Background="White">
                <TextBlock x:Name="ZoomedFps" AutomationProperties.AutomationId="ZoomedFps"
                           Text="{x:Bind ViewModel.ZoomedTile.FpsText, Mode=OneWay}"
                           Foreground="Black" FontFamily="Consolas"/>
            </Border>
            <Button Content="Back to grid" Click="Back_Click"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12"/>
        </Grid>

        <!-- CONTROL BAR (both modes) -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center"
                    Spacing="12" Padding="12">
            <!-- "Start screen sharing" when off; turns red with "Stop screen sharing" while sharing -->
            <ToggleButton x:Name="ShareButton"
                          AutomationProperties.AutomationId="ShareButton"
                          IsChecked="{x:Bind ViewModel.IsSharingScreen, Mode=TwoWay}"
                          Content="{x:Bind ViewModel.ShareButtonText, Mode=OneWay}"
                          AutomationProperties.Name="{x:Bind ViewModel.ShareButtonText, Mode=OneWay}"
                          MinWidth="200" Height="40" Padding="16,0" CornerRadius="4">
                <ToggleButton.Resources>
                    <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#C42B1C"/>
                    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#B3261A"/>
                    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#9C2116"/>
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="#C42B1C"/>
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="#B3261A"/>
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="#9C2116"/>
                    <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="White"/>
                    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="White"/>
                    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="White"/>
                </ToggleButton.Resources>
            </ToggleButton>
        </StackPanel>
    </Grid>
</UserControl>