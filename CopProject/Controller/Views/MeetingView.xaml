<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Controller.Views.MeetingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Controller.Models">

    <Grid Margin="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP SECTION: Replaces Meeting ID, Port, Participants, You are -->
        <Grid Grid.Row="0" ColumnSpacing="12" Height="170"
              Visibility="{x:Bind ViewModel.IsNormalVisible, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Participants Graph (Click to Maximize) -->
            <Border Background="White" CornerRadius="10" Padding="14,10"
                    Tapped="GraphCard_Tapped">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Participants Over Time" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="{x:Bind ViewModel.DurationText, Mode=OneWay}" FontSize="12" Foreground="Gray" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" Click="MaximizeGraph_Click" Padding="6,2" Background="Transparent" BorderThickness="0">
                            <FontIcon Glyph="&#xE740;" FontSize="12"/>
                        </Button>
                    </Grid>

                    <Canvas x:Name="MiniChartCanvas" Grid.Row="1" Background="#F9FAFB"
                            SizeChanged="MiniChartCanvas_SizeChanged"/>
                </Grid>
            </Border>

            <!-- Card 2: Security Audit Center (Click to Maximize) -->
            <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="14,10"
                    Tapped="AuditCard_Tapped">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <TextBlock Text="Security Audit Center" FontSize="14" FontWeight="SemiBold"/>
                        <Button HorizontalAlignment="Right" Click="MaximizeAudit_Click" Padding="6,2" Background="Transparent" BorderThickness="0">
                            <FontIcon Glyph="&#xE740;" FontSize="12"/>
                        </Button>
                    </Grid>

                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.AuditLogs, Mode=OneWay}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:SecurityAuditEvent">
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                                    <TextBlock Text="{x:Bind Time}" FontSize="11" Foreground="Gray"/>
                                    <TextBlock Text="{x:Bind User}" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Text="{x:Bind Activity}" FontSize="11"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <!-- Video Host + Participants Sidebar (Row 1) -->
        <Grid Grid.Row="1" ColumnSpacing="12"
              Visibility="{x:Bind ViewModel.IsNormalVisible, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Video Area -->
            <Border Background="White" CornerRadius="10" Padding="20">
                <ContentControl x:Name="VideoHost"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"/>
            </Border>

            <!-- Right: Participants Sidebar -->
            <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="16">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Sidebar Header -->
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE716;" FontSize="16"/>
                        <TextBlock Text="Participants" FontSize="16" FontWeight="SemiBold"/>
                        <Border Background="#EEF3F9" CornerRadius="10" Padding="8,2">
                            <TextBlock Text="{x:Bind ViewModel.Participants, Mode=OneWay}" 
                                       FontSize="12" FontWeight="SemiBold" Foreground="#0F5FC2"/>
                        </Border>
                    </StackPanel>

                    <!-- Participant List -->
                    <ListView Grid.Row="1"
                              ItemsSource="{x:Bind ViewModel.ParticipantList, Mode=OneWay}"
                              SelectionMode="None"
                              Padding="0,0,4,0">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:ParticipantInfo">
                                <Border Background="#F6F8FB" 
                                        BorderBrush="#E1E4E8" 
                                        BorderThickness="1" 
                                        CornerRadius="8" 
                                        Padding="12" 
                                        Margin="0,4,0,4">
                                    <Grid ColumnSpacing="12" RowSpacing="3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Avatar -->
                                        <PersonPicture Grid.RowSpan="2" 
                                                    DisplayName="{x:Bind Username}" 
                                                    ProfilePicture="{x:Bind AvatarImage, Mode=OneWay}"
                                                    Width="36" Height="36" 
                                                    VerticalAlignment="Center"/>

                                        <!-- Username -->
                                        <TextBlock Grid.Row="0" Grid.Column="1" 
                                                   Text="{x:Bind Username}" 
                                                   FontSize="14" 
                                                   FontWeight="SemiBold" 
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <!-- Role Badge -->
                                        <Border Grid.Row="0" Grid.Column="2" 
                                                Background="#EEF3F9" 
                                                CornerRadius="4" 
                                                Padding="6,2" 
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind RoleDisplay}" 
                                                       FontSize="11" 
                                                       Foreground="#0F5FC2" 
                                                       FontWeight="SemiBold"/>
                                        </Border>

                                        <!-- Full Email -->
                                        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                                   Text="{x:Bind Email}" 
                                                   FontSize="12" 
                                                   Opacity="0.65" 
                                                   TextWrapping="Wrap" 
                                                   IsTextSelectionEnabled="True"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <!-- Maximized View Overlay -->
        <Grid Grid.Row="0" Grid.RowSpan="2"
              Visibility="{x:Bind ViewModel.IsOverlayVisible, Mode=OneWay}">

            <!-- Maximized Graph -->
            <Border Background="White" CornerRadius="10" Padding="20"
                    Visibility="{x:Bind ViewModel.IsGraphMaximized, Mode=OneWay}">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <TextBlock Text="Participants Over Time (Maximized)" FontSize="18" FontWeight="SemiBold"/>
                        <Button HorizontalAlignment="Right" Click="CloseMaximized_Click" Content="Back / Minimize"/>
                    </Grid>

                    <Canvas x:Name="BigChartCanvas" Grid.Row="1" Background="#F9FAFB"
                            SizeChanged="BigChartCanvas_SizeChanged"/>
                </Grid>
            </Border>

            <!-- Maximized Security Audit Center -->
            <Border Background="White" CornerRadius="10" Padding="20"
                    Visibility="{x:Bind ViewModel.IsAuditMaximized, Mode=OneWay}">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <TextBlock Text="Security Audit Center" FontSize="18" FontWeight="SemiBold"/>
                        <Button HorizontalAlignment="Right" Click="CloseMaximized_Click" Content="Back / Minimize"/>
                    </Grid>

                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.AuditLogs, Mode=OneWay}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:SecurityAuditEvent">
                                <Border Background="#F6F8FB" BorderBrush="#E1E4E8" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,3">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="90"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Time}" FontSize="12" Foreground="Gray"/>
                                        <TextBlock Grid.Column="1" Text="{x:Bind User}" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="2" Text="{x:Bind Activity}" FontSize="12"/>
                                        <TextBlock Grid.Column="3" Text="{x:Bind Status}" FontSize="12" FontWeight="SemiBold" Foreground="#0F5FC2"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
