<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="App2.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:App2">

    <Grid x:Name="Root" RequestedTheme="Light" Background="#EEF3F9">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Grid Background="#0B2A4A" Padding="20,10">
            <TextBlock Text="SecureMeet" FontSize="20" FontWeight="SemiBold"
                       Foreground="White" VerticalAlignment="Center"/>

            <TextBlock x:Name="MeetingTitleText" Foreground="White" FontSize="16"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="Collapsed"/>

            <StackPanel x:Name="UserPanel" Orientation="Horizontal" Spacing="10"
                        HorizontalAlignment="Right" Visibility="Collapsed">
                <PersonPicture x:Name="ProfilePic" Width="30" Height="30"/>
                <TextBlock x:Name="ProfileName" Foreground="White" VerticalAlignment="Center"/>
                <Button Content="Sign out" Click="SignOut_Click" Foreground="White"/>
            </StackPanel>
        </Grid>

        <!-- Login screen -->
        <Grid x:Name="LoginView" Grid.Row="1">
            <Border Background="White" Width="400" Padding="30" CornerRadius="10"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="10">
                    <TextBlock Text="Welcome Back" FontSize="28" FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>

                    <!-- green message (account created, password reset) -->
                    <TextBlock x:Name="LoginInfo" Foreground="Green" TextWrapping="Wrap"
                               Visibility="Collapsed"/>
                    <!-- red message for general errors (too many attempts) -->
                    <TextBlock x:Name="LoginError" Foreground="Red" TextWrapping="Wrap"
                               Visibility="Collapsed"/>

                    <TextBox x:Name="EmailBox" Header="Email"/>
                    <TextBlock x:Name="EmailError" Foreground="Red" FontSize="12"
                               TextWrapping="Wrap" Visibility="Collapsed"/>

                    <PasswordBox x:Name="PassBox" Header="Password" KeyDown="PassBox_KeyDown"/>
                    <TextBlock x:Name="PassError" Foreground="Red" FontSize="12"
                               TextWrapping="Wrap" Visibility="Collapsed"/>

                    <Grid>
                        <CheckBox x:Name="RememberCheck" Content="Remember me"
                                  HorizontalAlignment="Left"/>
                        <HyperlinkButton Content="Forgot password?" Click="ForgotPassword_Click"
                                         HorizontalAlignment="Right"/>
                    </Grid>

                    <Button Content="SIGN IN" Click="SignIn_Click" Background="#0F5FC2"
                            Foreground="White" HorizontalAlignment="Stretch" Height="40"/>

                    <HyperlinkButton Content="Don't have an account? Create one"
                                     Click="SignUp_Click" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Dashboard screen -->
        <Grid x:Name="DashView" Grid.Row="1" Padding="40,24" RowSpacing="20" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="GreetingText" FontSize="32" FontWeight="SemiBold"/>

            <Grid Grid.Row="1" ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Button Content="Start Meeting" Click="Start_Click" Height="100"
                        Background="#0F5FC2" Foreground="White"
                        FontSize="20" HorizontalAlignment="Stretch"/>
                <Button Grid.Column="1" Content="Schedule Meeting" Click="Schedule_Click"
                        Height="100" FontSize="20" Background="White"
                        HorizontalAlignment="Stretch"/>
                <Button Grid.Column="2" Content="Join with ID" Click="Join_Click"
                        Height="100" FontSize="20" Background="White"
                        HorizontalAlignment="Stretch"/>
            </Grid>

            <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="20">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Previous Meeting Records" FontSize="18" FontWeight="SemiBold"/>
                    <ListView x:Name="RecordsList" Grid.Row="1" SelectionMode="None"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Meeting room screen -->
        <Grid x:Name="MeetingView" Grid.Row="1" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Main area: only one of these three is shown at a time -->
            <Grid Margin="16">
                <Border x:Name="VideoPanel" Background="White" CornerRadius="10">
                    <StackPanel Padding="20">
                        <!-- VIDEO TEAM: add your UI here -->
                        <TextBlock Text="Video module goes here"/>
                    </StackPanel>
                </Border>

                <Border x:Name="SharePanel" Background="White" CornerRadius="10" Visibility="Collapsed">
                    <StackPanel Padding="20">
                        <!-- SCREEN SHARING TEAM: add your UI here -->
                        <TextBlock Text="Screen sharing module goes here"/>
                    </StackPanel>
                </Border>

                <Border x:Name="BoardPanel" Background="White" CornerRadius="10" Visibility="Collapsed">
                    <StackPanel Padding="20">
                        <!-- WHITEBOARD TEAM: add your UI here -->
                        <TextBlock Text="Whiteboard module goes here"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Bottom toolbar -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center"
                        Spacing="8" Margin="0,0,0,16">
                <ToggleButton x:Name="VideoBtn" Content="Video" Click="VideoBtn_Click"
                              Width="100" Height="50" IsChecked="True"/>
                <ToggleButton x:Name="ShareBtn" Content="Share" Click="ShareBtn_Click"
                              Width="100" Height="50"/>
                <ToggleButton x:Name="BoardBtn" Content="Whiteboard" Click="BoardBtn_Click"
                              Width="100" Height="50"/>
                <ToggleButton x:Name="ChatBtn" Content="Chat" Click="ChatBtn_Click"
                              Width="100" Height="50"/>
                <Button Content="Info" Click="InfoBtn_Click" Width="100" Height="50"/>
                <Button Content="End Meeting" Click="End_Click" Width="120" Height="50"
                        Background="#D13438" Foreground="White"/>
            </StackPanel>

            <!-- Chat panel on the right -->
            <Border x:Name="ChatPanel" Grid.Column="1" Grid.RowSpan="2" Width="320"
                    Background="White" CornerRadius="10" Margin="0,16,16,16"
                    Visibility="Collapsed">
                <StackPanel Padding="16">
                    <!-- CHAT TEAM: add your UI here -->
                    <TextBlock Text="Chat module goes here"/>
                </StackPanel>
            </Border>

            <!-- Drag this strip (left edge of the chat) to make the chat wider or narrower -->
            <local:ResizeHandle x:Name="ChatResizer" Grid.Column="1" Grid.RowSpan="2" Width="10"
                                HorizontalAlignment="Left" Margin="0,16,0,16"
                                Background="Transparent" Visibility="Collapsed"
                                PointerPressed="ChatResizer_PointerPressed"
                                PointerMoved="ChatResizer_PointerMoved"
                                PointerReleased="ChatResizer_PointerReleased">
                <Border Width="4" Height="40" CornerRadius="2" Background="#B0B8C4"
                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </local:ResizeHandle>
        </Grid>
    </Grid>
</Window>
