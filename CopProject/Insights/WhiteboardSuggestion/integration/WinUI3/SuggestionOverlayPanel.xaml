<!--
  WinUI 3 version of the floating candidate panel.
  Copy this into the actual WinUI app, update the x:Class namespace, and add a project
  reference to WhiteboardSuggestion.Core. This sample is intentionally not part of the
  WPF demo solution because WPF and WinUI controls use different visual trees.
-->
<UserControl
    x:Class="YourApp.Controls.SuggestionOverlayPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:WhiteboardSuggestion.Core"
    Width="310"
    HorizontalAlignment="Right"
    VerticalAlignment="Top"
    Visibility="Collapsed">
    <Border
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="14"
        Padding="16">
        <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="AI SUGGESTIONS"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Opacity="0.7" />
                    <TextBlock x:Name="HeaderText"
                               Text="Choose a clean version"
                               FontSize="18"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="×"
                        Width="32"
                        Height="32"
                        Padding="0"
                        VerticalAlignment="Top"
                        Click="CloseButton_Click"
                        ToolTipService.ToolTip="Close suggestions" />
            </Grid>
            <TextBlock x:Name="ConfidenceText" FontSize="12" Opacity="0.7" />
            <TextBlock x:Name="ExplanationText" FontSize="12" TextWrapping="Wrap" />
            <TextBlock Text="Click an option to replace the rough sketch"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Margin="0,4,0,0" />
            <ItemsControl x:Name="CandidatesList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="core:SuggestionCandidate">
                        <Button Content="{x:Bind Label}"
                                Tag="{x:Bind}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Margin="0,3,0,0"
                                Padding="12,10"
                                Click="CandidateButton_Click" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="NoCandidatesText"
                       Text="No safe suggestion to insert yet. Draw more clearly and try again."
                       Foreground="DarkOrange"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Visibility="Collapsed" />
        </StackPanel>
    </Border>
</UserControl>
