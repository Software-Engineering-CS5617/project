<UserControl x:Class="WhiteboardSuggestion.WpfDemo.Controls.SuggestionOverlayControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="250">
    <Border Background="#FCFFFFFF"
            BorderBrush="#DDE3EE"
            BorderThickness="1"
            CornerRadius="16"
            Padding="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="3" Opacity="0.16" />
        </Border.Effect>
        <StackPanel>
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right"
                        Content="×"
                        Width="30"
                        Height="30"
                        Padding="0"
                        Margin="8,0,0,0"
                        FontSize="19"
                        BorderThickness="0"
                        Background="Transparent"
                        Click="CloseButton_Click"
                        ToolTip="Close suggestions" />
                <StackPanel>
                    <TextBlock Text="AI SUGGESTIONS"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="#667085" />
                    <TextBlock x:Name="HeaderText"
                               Text="Choose a clean version"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#172033"
                               Margin="0,3,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>

            <TextBlock x:Name="ConfidenceText"
                       FontSize="12"
                       Foreground="#667085"
                       Margin="0,8,0,0" />
            <TextBlock x:Name="ExplanationText"
                       FontSize="12"
                       Foreground="#475467"
                       TextWrapping="Wrap"
                       Margin="0,8,0,2" />

            <TextBlock Text="Click an option to replace the rough sketch"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="#475467"
                       Margin="0,10,0,4" />
            <ItemsControl x:Name="CandidatesList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Label}"
                                Tag="{Binding}"
                                HorizontalContentAlignment="Left"
                                Margin="0,4,0,0"
                                Padding="12,10"
                                Click="CandidateButton_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#FFFFFF" />
                                    <Setter Property="BorderBrush" Value="#D0D5DD" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="Foreground" Value="#172033" />
                                    <Setter Property="FontWeight" Value="Normal" />
                                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRecommended}" Value="True">
                                            <Setter Property="Background" Value="#4F46E5" />
                                            <Setter Property="BorderBrush" Value="#4F46E5" />
                                            <Setter Property="Foreground" Value="White" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="NoCandidatesText"
                       Text="No safe suggestion to insert yet. Draw more clearly and try again."
                       FontSize="12"
                       Foreground="#B54708"
                       TextWrapping="Wrap"
                       Margin="0,10,0,0"
                       Visibility="Collapsed" />
        </StackPanel>
    </Border>
</UserControl>
