<Window x:Class="WhiteboardSuggestion.WpfDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WhiteboardSuggestion.WpfDemo.Controls"
        Title="Whiteboard AI Suggestions"
        Width="1380"
        Height="850"
        MinWidth="980"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6FA">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="Whiteboard AI"
                           FontSize="27"
                           FontWeight="Bold"
                           Foreground="#172033" />
                <TextBlock Text="Draw roughly. Get suggestions. Click one to clean up the drawing."
                           FontSize="14"
                           Foreground="#667085"
                           Margin="0,4,0,0" />
            </StackPanel>
            <Border HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="#E8EAFD"
                    CornerRadius="12"
                    Padding="12,8">
                <TextBlock Text="INTERACTIVE DEMO"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="#4338CA" />
            </Border>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="SuggestButton"
                        Content="✦  Suggest correction"
                        Background="#4F46E5"
                        Foreground="White"
                        BorderBrush="#4F46E5"
                        FontWeight="SemiBold"
                        Click="SuggestButton_Click" />
                <Button Content="Clear board"
                        Margin="8,0,0,0"
                        Click="ClearBoardButton_Click" />
                <TextBlock x:Name="StatusText"
                           Text="Draw one shape, letter, or digit on the board."
                           VerticalAlignment="Center"
                           Foreground="#667085"
                           Margin="16,0,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" ClipToBounds="True">
            <Border Background="White"
                    BorderBrush="#DDE3EE"
                    BorderThickness="1"
                    CornerRadius="18" />
            <Canvas x:Name="DrawingCanvas"
                    Background="White"
                    Margin="1"
                    ClipToBounds="True"
                    MouseLeftButtonDown="DrawingCanvas_MouseLeftButtonDown"
                    MouseMove="DrawingCanvas_MouseMove"
                    MouseLeftButtonUp="DrawingCanvas_MouseLeftButtonUp" />

            <Border HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Margin="16"
                    Background="#F7F9FC"
                    BorderBrush="#EAECF0"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12,8"
                    IsHitTestVisible="False">
                <TextBlock Text="Mouse: draw with left-click and drag  ·  Click an AI option to replace the sketch"
                           FontSize="12"
                           Foreground="#667085" />
            </Border>

            <controls:SuggestionOverlayControl x:Name="SuggestionOverlay"
                                               Width="300"
                                               MaxHeight="560"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Top"
                                               Margin="16"
                                               Visibility="Collapsed"
                                               CandidateSelected="SuggestionOverlay_CandidateSelected"
                                               OverlayClosed="SuggestionOverlay_OverlayClosed" />
        </Grid>
    </Grid>
</Window>
